secrets/

# Drive-pull of Bosch MDG1 reference material (~2.5 GB). Contains ODX files
# with embedded RSA pubkeys, encrypted FRF flash containers, per-variant
# block maps, and Bosch's protocol PDFs. All proprietary IP per Hard Rule 5.
# Stays local; never committed.
hw_reference/vag_mdg1_drive_pull/

# Host test build artifacts — rebuilt every eval run; never source.
firmware/test/*/host_test_runner
firmware/test/*/host_test_runner.dSYM/

# build artifacts and IDE cache (rebuilt every session, never source of truth)
firmware/build/
firmware/.cache/

# UI eval Python caches (sources are mock_dongle.py / test_round_trip.py).
ui/test/__pycache__/
ui/test/*.pyc

# Tool Python caches (sources are bundle_ui.py / sbf_to_json.py /
# can_sniff.py / bench_push.py).
tools/__pycache__/
tools/*.pyc

# Agent-task worktrees + scheduler state — transient runtime, not portable.
.claude/

# External-volume mounts (drive-pulls, dongle SDcard captures, etc.)
# never get committed via this repo.
/Volumes/

# Raw ECU binary dumps — proprietary IP per Hard Rule 5. Stay local.
*.bin

# macOS Finder noise.
.DS_Store

# Dev-session wire captures: rolling logs/CSVs are regenerated every session
# and are not source. Per-commit pins (Rule 11) are added explicitly with
# `git add -f <sha>.log` when a build needs one. Already-tracked logs (e.g.
# obd_clear.log) are intentionally left as-is — untracking them is a separate
# cleanup decision, not part of this change.
firmware/test/can_capture/dev_session/*.log
firmware/test/can_capture/dev_session/*.csv
