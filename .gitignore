secrets/

# Drive-pull of Bosch MDG1 reference material (~2.5 GB). Contains ODX files
# with embedded RSA pubkeys, encrypted FRF flash containers, per-variant
# block maps, and Bosch's protocol PDFs. All proprietary IP per Hard Rule 5.
# Stays local; never committed.
hw_reference/vag_mdg1_drive_pull/

# Host test build artifacts — rebuilt every eval run; never source.
firmware/test/*/host_test_runner
firmware/test/*/host_test_runner.dSYM/

# build artifacts and IDE cache (rebuilt every session, never source of truth)
firmware/build/
firmware/.cache/

# UI eval Python caches (sources are mock_dongle.py / test_round_trip.py).
ui/test/__pycache__/
ui/test/*.pyc

# Tool Python caches (sources are bundle_ui.py / sbf_to_json.py /
# can_sniff.py / bench_push.py).
tools/__pycache__/
tools/*.pyc

# Agent-task worktrees — transient runtime state, not portable.
.claude/worktrees/
