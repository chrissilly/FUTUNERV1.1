# Use default UART for console (normal USB via USB-to-UART chip)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_USB_CDC=n

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# HTTP Server WebSocket Support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Task stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Flash: 16MB (this dongle batch — 8MB PSRAM embedded)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: 16MB Octal SPI (ESP32-S3-WROOM-2-N32R16V)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Brownout: lower threshold to avoid false resets during WiFi TX current spikes
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_3=y
CONFIG_ESP_BROWNOUT_DET_LVL=3

# WiFi TX power: 8 dBm (enough for in-car use, avoids power supply brownout)
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=8